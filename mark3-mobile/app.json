{
  "expo": {
    "name": "mark3-mobile",
    "slug": "mark3-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a1a"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1a1a"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "왕국 연대기",
      "shortName": "왕국 연대기",
      "lang": "ko",
      "themeColor": "#1a1a1a",
      "description": "정의로 다스릴까, 공포로 다스릴까 — 육각 전략 게임"
    }
  }
}
